<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Let SDK include source files implicitly to avoid duplicate Compile items -->
  <PropertyGroup>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Remove explicit Compile includes; SDK will include *.cs automatically -->

    <Folder Include="Properties\" />
  </ItemGroup>
</Project>